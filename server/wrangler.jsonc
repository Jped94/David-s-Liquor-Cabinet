{
  // Cloudflare Worker for David's Liquor Cabinet: the shared menu API.
  // Deploy setup is described in README.md (Shared server).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owls-perch-lc",
  "main": "src/index.ts",
  "account_id": "0904f98322ff2119789ad2e18d48d61d",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liquor-cabinet",
      "database_id": "900cccd0-9cd8-4f5f-8c92-3caa8ef2db3d",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `wrangler secret put`, never committed):
  //   GUEST_PASSCODE, ADMIN_PASSCODE, SESSION_SECRET
}
