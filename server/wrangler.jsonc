{
  // Cloudflare Worker for David's Liquor Cabinet: the shared menu API.
  // Deploy setup is described in README.md (Shared server).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liquor-cabinet",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liquor-cabinet",
      // Replaced with the real ID after `wrangler d1 create liquor-cabinet`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `wrangler secret put`, never committed):
  //   GUEST_PASSCODE, ADMIN_PASSCODE, SESSION_SECRET
}
